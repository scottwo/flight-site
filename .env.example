# Application database. Use a local development database here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mypilotpage

# Optional direct database connection used by the airport seeding script.
DIRECT_URL=

# Clerk authentication (https://dashboard.clerk.com/).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Blob. Required for logbook and resume uploads.
BLOB_READ_WRITE_TOKEN=
# Set this when the Blob service cannot infer the callback origin.
VERCEL_BLOB_CALLBACK_URL=http://localhost:3000

# Contact form delivery through Resend. If these are unset, delivery is disabled.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional alpha-cap controls.
ALPHA_LIMIT_ENABLED=false
ALPHA_MAX_USERS=40

# Explicit safety switch required by `npm run seed:dev`.
ALLOW_DEV_SEED=false

# Optional local LogTen database used only by the legacy static export script.
LOGTEN_DB_PATH=

# Dedicated migrated database used by `npm run test:integration`.
# Never point this at development, staging, or production data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mypilotpage_test
